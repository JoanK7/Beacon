# Copy to .env and adjust. Never commit the real .env file.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string (docker-compose default shown)
DATABASE_URL=postgres://beacon:beacon@localhost:5433/beacon
# Set to true for managed databases that require SSL (e.g. Render, Neon)
DATABASE_SSL=false

# 32-byte base64 key for encrypting session notes and reflections.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Optional in development (a fixed dev key is used); REQUIRED in production.
# Changing it makes previously encrypted notes unreadable.
ENCRYPTION_KEY=

# Browser origins allowed to call the API directly (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Reverse proxies in front of the API: 1 = Render only, 2 = Vercel proxy + Render (production)
TRUST_PROXY=1

# How long a login lasts, in hours
SESSION_TTL_HOURS=168

# Starter account passwords used by `npm run db:seed`.
# Dev defaults are used if blank; REQUIRED in production.
SEED_ADMIN_PASSWORD=
SEED_COORDINATOR_PASSWORD=
SEED_DEMO_PASSWORD=

# Only needed to run the integration tests (database is WIPED; name must contain "test")
TEST_DATABASE_URL=postgres://beacon:beacon@localhost:5433/beacon_test
